# Environment Variables Configuration
# Since we moved to a serverless GitHub Actions architecture, we no longer need database credentials!

# Logging Configuration
LOG_LEVEL=INFO

# Scraper Configuration
# Set to 'true' to run the browser visibly locally, or 'false' for headless mode
PLAYWRIGHT_HEADLESS=true

# Add your Groq API Key here for intelligent extraction and scoring
GROQ_API_KEY=your_groq_api_key_here
